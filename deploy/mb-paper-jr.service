# Third paper book (configs/paper/momentum_b_top25_gold25_jr_gap.yaml, docs/paper.md). Install like mb-paper.service. Both jobs take
# the same lock, so they never download or build the shared daily dataset at the same time.
[Unit]
Description=multibagger paper trading daily job (momentum_b_top25_gold25_jr_gap)

[Service]
Type=oneshot
WorkingDirectory=%h/projects/multibagger-v2
# MB_NTFY_TOPIC=<topic>, mode 0600
EnvironmentFile=%h/.config/multibagger/alerts.env
ExecStart=/usr/bin/flock %h/.config/multibagger/paper.lock %h/.local/bin/uv run --frozen mb paper daily configs/paper/momentum_b_top25_gold25_jr_gap.yaml
Nice=10
TimeoutStartSec=3600
